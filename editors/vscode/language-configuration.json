{
    "comments": {
        "lineComment": "//"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*///.*$",
            "action": { "indent": "none", "appendText": "/// " }
        }
    ],
    "brackets": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "{", "close": "}" },
        { "open": "\"", "close": "\"", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["{", "}"],
        ["\"", "\""]
    ]
}
