{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Mialu",
    "scopeName": "source.mialu",
    "patterns": [
        {
            "include": "#strings"
        },
        {
            "include": "#reserved-words"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "strings": {
            "name": "string.quoted.double.mialu",
            "comment": "A string has no escape sequences yet, and ends with its line.",
            "match": "\"[^\"\\\\\\n]*\""
        },
        "operators": {
            "name": "keyword.operator.arithmetic.mialu",
            "match": "\\+"
        },
        "reserved-words": {
            "patterns": [
                {
                    "name": "storage.type.function.mialu",
                    "match": "\\bproc\\b"
                },
                {
                    "name": "keyword.control.return.mialu",
                    "match": "\\breturn\\b"
                }
            ]
        }
    }
}
