{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Mialu",
    "scopeName": "source.mialu",
    "patterns": [
        {
            "include": "#documentation-comments"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#attributes"
        },
        {
            "include": "#labels"
        },
        {
            "include": "#type-definitions"
        },
        {
            "include": "#procedure-types"
        },
        {
            "include": "#array-brackets"
        },
        {
            "include": "#type-positions"
        },
        {
            "include": "#reserved-words"
        },
        {
            "include": "#calls"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#primitive-types"
        }
    ],
    "repository": {
        "documentation-comments": {
            "comment": "A documentation comment is a line of its own that starts with three slashes. Lines of it in a row are one comment for the compiler, and each line is colored here on its own. Three slashes after code are an error, which is also marked here.",
            "patterns": [
                {
                    "name": "comment.line.documentation.mialu",
                    "match": "^[ \\t]*(///).*$",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.comment.mialu"
                        }
                    }
                },
                {
                    "name": "invalid.illegal.documentation-comment.mialu",
                    "match": "///.*$"
                }
            ]
        },
        "comments": {
            "comment": "Two slashes start a comment that goes on to the end of the line, also after code. There are no comments in the middle of a line. It is included before the strings, but a string that has two slashes in it is not a comment, because the string starts first.",
            "name": "comment.line.double-slash.mialu",
            "match": "(//).*$",
            "captures": {
                "1": {
                    "name": "punctuation.definition.comment.mialu"
                }
            }
        },
        "strings": {
            "name": "string.quoted.double.mialu",
            "comment": "A string has no escape sequences, so a backslash is invalid, and it ends with its line.",
            "begin": "\"",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.string.begin.mialu"
                }
            },
            "end": "\"|(?=$)",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.mialu"
                }
            },
            "patterns": [
                {
                    "name": "invalid.illegal.backslash.mialu",
                    "match": "\\\\"
                }
            ]
        },
        "attributes": {
            "name": "meta.attribute.mialu",
            "comment": "An attribute list: a # and one or more attributes, each of them a name between parentheses, as in #(static). It ends at the first thing that is not another attribute. The names are scoped as attribute names, so a theme can give them a color of their own, and they are not taken for calls or reserved words.",
            "begin": "#",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.attribute.mialu"
                }
            },
            "end": "(?![ \\t]*\\()",
            "patterns": [
                {
                    "match": "(\\()[ \\t]*([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(\\))",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.attribute.begin.mialu"
                        },
                        "2": {
                            "name": "entity.other.attribute-name.mialu"
                        },
                        "3": {
                            "name": "punctuation.definition.attribute.end.mialu"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "punctuation.separator.arrow.mialu",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.range.mialu",
                    "comment": "The end of a range in a for statement, exclusive or inclusive. It comes before the comparisons, so that the < and <= in it are not taken for them.",
                    "match": "\\.\\.<=|\\.\\.<"
                },
                {
                    "name": "keyword.operator.comparison.mialu",
                    "match": "==|not=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.compound.mialu",
                    "match": "\\+=|-=|\\*=|/="
                },
                {
                    "name": "keyword.operator.assignment.mialu",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.mialu",
                    "match": "\\+|-|\\*|/"
                },
                {
                    "name": "keyword.operator.address.mialu",
                    "comment": "The % before an expression, which takes its address, as in %x.",
                    "match": "%"
                },
                {
                    "name": "keyword.operator.pointer.mialu",
                    "comment": "The ^ of a pointer type, as in ^Int, and the ^ after a pointer that gives what it points to, as in p^. Both are the same token for the compiler.",
                    "match": "\\^"
                },
                {
                    "name": "keyword.operator.type.mialu",
                    "comment": "The colon of a type separator, and of the two bounds of an array slice, as in a[1:4].",
                    "match": ":"
                },
                {
                    "name": "keyword.operator.ellipsis.mialu",
                    "comment": "The ... that stands where the body of a foreign procedure would be. It comes before the dot of a field access, so its dots are not taken for that.",
                    "match": "\\.\\.\\."
                },
                {
                    "name": "punctuation.accessor.dot.mialu",
                    "comment": "The dot of a field access, as in p.age. The tokens ..< and ..<= of a range come before it, so their dots are not taken for it.",
                    "match": "\\."
                },
                {
                    "name": "punctuation.section.brackets.mialu",
                    "comment": "The brackets of an array type, of a subscript and of a slice, and the braces of an array literal.",
                    "match": "[\\[\\]{}]"
                }
            ]
        },
        "labels": {
            "patterns": [
                {
                    "name": "entity.name.label.mialu",
                    "comment": "The label of a statement: an @ directly followed by a name, as in @outer -> or @outer for.",
                    "match": "@[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                    "comment": "A break or a continue that names a statement, which is written without the @, as in break outer.",
                    "match": "\\b(break|continue)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.flow.mialu"
                        },
                        "2": {
                            "name": "entity.name.label.mialu"
                        }
                    }
                }
            ]
        },
        "calls": {
            "patterns": [
                {
                    "name": "entity.name.function.call.mialu",
                    "comment": "A name that is directly followed by an opening parenthesis is a call. The reserved words come first, so proc( is not one.",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()"
                }
            ]
        },
        "reserved-words": {
            "patterns": [
                {
                    "name": "storage.type.function.mialu",
                    "match": "\\bproc\\b"
                },
                {
                    "name": "keyword.control.return.mialu",
                    "match": "\\breturn\\b"
                },
                {
                    "name": "keyword.control.conditional.mialu",
                    "match": "\\b(if|else)\\b"
                },
                {
                    "name": "keyword.control.loop.mialu",
                    "match": "\\b(for|in)\\b"
                },
                {
                    "name": "keyword.control.flow.mialu",
                    "match": "\\b(break|continue)\\b"
                },
                {
                    "name": "keyword.control.import.mialu",
                    "comment": "The words of import foreign js \"name\" and of foreign js ->, which declare the procedures that come from JavaScript.",
                    "match": "\\b(foreign|import)\\b"
                },
                {
                    "name": "storage.type.enum.mialu",
                    "comment": "The word that starts the definition of an enum, as in Color :: enum Int ->.",
                    "match": "\\benum\\b"
                },
                {
                    "name": "storage.type.struct.mialu",
                    "comment": "The word that starts the definition of a struct or of a field that is a struct, as in Person :: struct ->.",
                    "match": "\\bstruct\\b"
                },
                {
                    "name": "storage.type.union.mialu",
                    "comment": "The word that starts a union match among the fields of a struct, as in union match kind ->.",
                    "match": "\\bunion\\b"
                },
                {
                    "name": "keyword.control.match.mialu",
                    "comment": "The word after union, and the word that starts a case of a union match, as in union match kind -> and case .IDENTIFIER ->.",
                    "match": "\\b(match|case)\\b"
                },
                {
                    "name": "keyword.operator.type-info.mialu",
                    "comment": "The operator that gathers information about a type while the program is compiled, as in type_info_of(Color).members. It comes before the calls, so it is not taken for one.",
                    "match": "\\btype_info_of\\b"
                },
                {
                    "name": "storage.modifier.const.mialu",
                    "comment": "The length of an array type that is the number of elements of the array literal that it starts, as in [const]Int { 1, 2 }.",
                    "match": "\\bconst\\b"
                },
                {
                    "name": "keyword.operator.word.mialu",
                    "comment": "The logical operators and, or and not. Not is skipped when it is the start of the operator not=, which is highlighted as an operator.",
                    "match": "\\b(?:and|or)\\b|\\bnot\\b(?!=)"
                },
                {
                    "name": "constant.language.boolean.mialu",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.language.nil.mialu",
                    "comment": "The null pointer.",
                    "match": "\\bnil\\b"
                }
            ]
        },
        "primitive-types": {
            "comment": "The primitive data types Bool, Int and Str, and the ones that are reserved for the future. They are colored wherever they are written, also when they are not in a place that the other rules recognize as a type.",
            "patterns": [
                {
                    "name": "support.type.primitive.mialu",
                    "match": "\\b(?:Bool|Int|Str|Byte|Rune|F32|F64|I8|I16|I32|I64|U8|U16|U32|U64)\\b"
                }
            ]
        },
        "type-definitions": {
            "patterns": [
                {
                    "comment": "The name of a struct or an enum at its definition, as in Person :: struct ->. The type of the numbers of an enum, as in the Int of enum Int, is a type too.",
                    "match": "^[ \\t]*((?!(?:proc|return|if|else|for|in|break|continue|foreign|import|enum|struct|union|match|case|type_info_of|const|and|or|not|true|false|nil)\\b)[A-Za-z_][A-Za-z0-9_]*)[ \\t]*(::)(?=[ \\t]*(?:struct|enum)\\b)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.mialu",
                            "patterns": [
                                {
                                    "include": "#primitive-types"
                                }
                            ]
                        },
                        "2": {
                            "name": "keyword.operator.type.mialu"
                        }
                    }
                },
                {
                    "match": "\\b(enum)\\b[ \\t]+((?!(?:proc|return|if|else|for|in|break|continue|foreign|import|enum|struct|union|match|case|type_info_of|const|and|or|not|true|false|nil)\\b)[A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.enum.mialu"
                        },
                        "2": {
                            "name": "entity.name.type.mialu",
                            "patterns": [
                                {
                                    "include": "#primitive-types"
                                }
                            ]
                        }
                    }
                },
                {
                    "comment": "The type that type_info_of gathers information about, as in type_info_of(Color).members.",
                    "match": "\\b(type_info_of)\\b[ \\t]*(\\()[ \\t]*((?!(?:proc|return|if|else|for|in|break|continue|foreign|import|enum|struct|union|match|case|type_info_of|const|and|or|not|true|false|nil)\\b)[A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.type-info.mialu"
                        },
                        "3": {
                            "name": "entity.name.type.mialu",
                            "patterns": [
                                {
                                    "include": "#primitive-types"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "type-positions": {
            "comment": "The places in which a name is a type: after the colon of a type separator, as in x: Int, after a ^ of a pointer type, after the ] of an array type or of a slice type, after the ) of a procedure, as its return type, and before the { of a struct literal, as in Person { age = 30 }. The colon of a slice, as in a[1:4], is inside brackets, where these rules are not in use, so its upper bound is not taken for a type. The colon rule comes before the operators, so it takes the colon as well.",
            "patterns": [
                {
                    "match": "((?<!:):)(?![:=])([ \\t]*)((?!(?:proc|return|if|else|for|in|break|continue|foreign|import|enum|struct|union|match|case|type_info_of|const|and|or|not|true|false|nil)\\b)[A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.type.mialu"
                        },
                        "3": {
                            "name": "entity.name.type.mialu",
                            "patterns": [
                                {
                                    "include": "#primitive-types"
                                }
                            ]
                        }
                    }
                },
                {
                    "match": "(?<=\\^)[ \\t]*((?!(?:proc|return|if|else|for|in|break|continue|foreign|import|enum|struct|union|match|case|type_info_of|const|and|or|not|true|false|nil)\\b)[A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.mialu",
                            "patterns": [
                                {
                                    "include": "#primitive-types"
                                }
                            ]
                        }
                    }
                },
                {
                    "match": "(?<=\\])[ \\t]*((?!(?:proc|return|if|else|for|in|break|continue|foreign|import|enum|struct|union|match|case|type_info_of|const|and|or|not|true|false|nil)\\b)[A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.mialu",
                            "patterns": [
                                {
                                    "include": "#primitive-types"
                                }
                            ]
                        }
                    }
                },
                {
                    "match": "(?<=\\))[ \\t]*((?!(?:proc|return|if|else|for|in|break|continue|foreign|import|enum|struct|union|match|case|type_info_of|const|and|or|not|true|false|nil)\\b)[A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.mialu",
                            "patterns": [
                                {
                                    "include": "#primitive-types"
                                }
                            ]
                        }
                    }
                },
                {
                    "match": "\\b((?!(?:proc|return|if|else|for|in|break|continue|foreign|import|enum|struct|union|match|case|type_info_of|const|and|or|not|true|false|nil)\\b)[A-Za-z_][A-Za-z0-9_]*)(?=[ \\t]*\\{)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.mialu",
                            "patterns": [
                                {
                                    "include": "#primitive-types"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "array-brackets": {
            "comment": "A pair of brackets: the length of an array type, a subscript or the bounds of a slice. What is between them is an expression, so a name there is not a type, and the colon of a slice is not a type separator. The type after the closing bracket is found by the rules of the type positions.",
            "begin": "\\[",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.section.brackets.mialu"
                }
            },
            "end": "\\]",
            "endCaptures": {
                "0": {
                    "name": "punctuation.section.brackets.mialu"
                }
            },
            "patterns": [
                {
                    "include": "#strings"
                },
                {
                    "include": "#array-brackets"
                },
                {
                    "include": "#reserved-words"
                },
                {
                    "include": "#calls"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#primitive-types"
                }
            ]
        },
        "procedure-types": {
            "comment": "The parameters of a procedure, or of a pointer to one. A name that is not followed by a colon is a type, as in the Int of proc(Int) Int, and a name that is followed by one is the name of a parameter, as in the a of proc(a: Int) Int.",
            "begin": "\\b(proc)\\b[ \\t]*(\\()",
            "beginCaptures": {
                "1": {
                    "name": "storage.type.function.mialu"
                }
            },
            "end": "\\)",
            "patterns": [
                {
                    "include": "#procedure-types"
                },
                {
                    "include": "#array-brackets"
                },
                {
                    "include": "#type-positions"
                },
                {
                    "match": "\\b((?!(?:proc|return|if|else|for|in|break|continue|foreign|import|enum|struct|union|match|case|type_info_of|const|and|or|not|true|false|nil)\\b)[A-Za-z_][A-Za-z0-9_]*)\\b(?![ \\t]*:)",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.mialu",
                            "patterns": [
                                {
                                    "include": "#primitive-types"
                                }
                            ]
                        }
                    }
                },
                {
                    "include": "#operators"
                }
            ]
        }
    }
}
