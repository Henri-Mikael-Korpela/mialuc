{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Mialu",
    "scopeName": "source.mialu",
    "patterns": [
        {
            "include": "#strings"
        },
        {
            "include": "#labels"
        },
        {
            "include": "#reserved-words"
        },
        {
            "include": "#calls"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "strings": {
            "name": "string.quoted.double.mialu",
            "comment": "A string has no escape sequences, so a backslash is invalid, and it ends with its line.",
            "begin": "\"",
            "beginCaptures": {
                "0": { "name": "punctuation.definition.string.begin.mialu" }
            },
            "end": "\"|(?=$)",
            "endCaptures": {
                "0": { "name": "punctuation.definition.string.end.mialu" }
            },
            "patterns": [
                {
                    "name": "invalid.illegal.backslash.mialu",
                    "match": "\\\\"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "punctuation.separator.arrow.mialu",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.range.mialu",
                    "comment": "The end of a range in a for statement, exclusive or inclusive. It comes before the comparisons, so that the < and <= in it are not taken for them.",
                    "match": "\\.\\.<=|\\.\\.<"
                },
                {
                    "name": "keyword.operator.comparison.mialu",
                    "match": "==|not=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.compound.mialu",
                    "match": "\\+=|-=|\\*=|/="
                },
                {
                    "name": "keyword.operator.assignment.mialu",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.mialu",
                    "match": "\\+|-|\\*|/"
                },
                {
                    "name": "keyword.operator.type.mialu",
                    "match": ":"
                }
            ]
        },
        "labels": {
            "patterns": [
                {
                    "name": "entity.name.label.mialu",
                    "comment": "The label of a scope: an @ directly followed by a name, as in @outer ->.",
                    "match": "@[A-Za-z_][A-Za-z0-9_]*"
                },
                {
                    "comment": "A break that names the scope to leave, which is written without the @, as in break outer.",
                    "match": "\\b(break)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.control.flow.mialu" },
                        "2": { "name": "entity.name.label.mialu" }
                    }
                }
            ]
        },
        "calls": {
            "patterns": [
                {
                    "name": "entity.name.function.call.mialu",
                    "comment": "A name that is directly followed by an opening parenthesis is a call. The reserved words come first, so proc( is not one.",
                    "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()"
                }
            ]
        },
        "reserved-words": {
            "patterns": [
                {
                    "name": "storage.type.function.mialu",
                    "match": "\\bproc\\b"
                },
                {
                    "name": "keyword.control.return.mialu",
                    "match": "\\breturn\\b"
                },
                {
                    "name": "keyword.control.conditional.mialu",
                    "match": "\\b(if|else)\\b"
                },
                {
                    "name": "keyword.control.loop.mialu",
                    "match": "\\b(for|in)\\b"
                },
                {
                    "name": "keyword.control.flow.mialu",
                    "match": "\\b(break|continue)\\b"
                },
                {
                    "name": "keyword.operator.word.mialu",
                    "comment": "The logical operators and, or and not. Not is skipped when it is the start of the operator not=, which is highlighted as an operator.",
                    "match": "\\b(?:and|or)\\b|\\bnot\\b(?!=)"
                },
                {
                    "name": "constant.language.boolean.mialu",
                    "match": "\\b(true|false)\\b"
                }
            ]
        }
    }
}
