{
    "name": "mialu",
    "displayName": "Mialu",
    "description": "Language support for the Mialu programming language.",
    "version": "0.0.1",
    "publisher": "mialu",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "mialu",
                "aliases": [
                    "Mialu",
                    "mialu"
                ],
                "extensions": [
                    ".mu"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "mialu",
                "scopeName": "source.mialu",
                "path": "./syntaxes/mialu.tmLanguage.json"
            }
        ],
        "configurationDefaults": {
            "editor.tokenColorCustomizations": {
                "textMateRules": [
                    {
                        "scope": [
                            "constant.language.boolean.mialu",
                            "constant.language.nil.mialu"
                        ],
                        "settings": {
                            "foreground": "#d19a66"
                        }
                    },
                    {
                        "scope": [
                            "entity.name.type.mialu",
                            "support.type.primitive.mialu"
                        ],
                        "settings": {
                            "foreground": "#e5c07b"
                        }
                    },
                    {
                        "scope": [
                            "keyword.operator.address.mialu",
                            "keyword.operator.arithmetic.mialu",
                            "keyword.operator.assignment.compound.mialu",
                            "keyword.operator.assignment.mialu",
                            "keyword.operator.comparison.mialu",
                            "keyword.operator.ellipsis.mialu",
                            "keyword.operator.pointer.mialu",
                            "keyword.operator.range.mialu",
                            "keyword.operator.type.mialu",
                            "keyword.operator.word.mialu",
                            "punctuation.accessor.dot.mialu",
                            "punctuation.separator.arrow.mialu"
                        ],
                        "settings": {
                            "foreground": "#56b6c2"
                        }
                    }
                ]
            }
        }
    }
}
