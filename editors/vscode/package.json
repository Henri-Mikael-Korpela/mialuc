{
    "name": "mialu",
    "displayName": "Mialu",
    "description": "Language support for the Mialu programming language.",
    "version": "0.0.1",
    "publisher": "mialu",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "mialu",
                "aliases": [
                    "Mialu",
                    "mialu"
                ],
                "extensions": [
                    ".mu"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "mialu",
                "scopeName": "source.mialu",
                "path": "./syntaxes/mialu.tmLanguage.json"
            }
        ],
        "configurationDefaults": {
            "editor.tokenColorCustomizations": {
                "textMateRules": [
                    {
                        "scope": [
                            "constant.language.boolean.mialu",
                            "constant.language.nil.mialu"
                        ],
                        "settings": {
                            "foreground": "#d19a66"
                        }
                    }
                ]
            }
        }
    }
}
