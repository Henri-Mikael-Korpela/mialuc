 7 | main :: proc() Int ->
 8 |     c := Color.RED
 9 |     match c ->
   |     ^^^^^ this match leaves a member out
10 |         case .RED ->
11 |             c = Color.GREEN
   |
   = help: add a case for each member, or a default case 'case ->', or write 'match #(partial)' to
