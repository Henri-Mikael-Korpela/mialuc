(*
   Grammar of the Mialu programming language, in EBNF.

   The grammar works directly on the characters of a source file, without a separate tokenizer
   step. So it spells out where spaces may appear, and indentation is part of it. It describes
   what the compiler in src/ accepts today, which is only a part of the language; the language
   itself is described in docs/mialu-programming-language.md. Check a source file against it with
   scripts/verify_grammar.py.

   Notation, which is ISO 14977 EBNF with three small extensions:

     name = ... ;     defines a rule
     a , b            a followed by b
     a | b            a or b
     [ a ]            a, or nothing
     { a }            a repeated zero or more times
     ( a )            grouping
     a - b            a, except where b matches exactly the same text
     "text" 'text'    the characters in between
     ? ... ?          a special sequence, here "end of input" and "any character"
     comment          text between an opening parenthesis with an asterisk and an asterisk with a
                      closing parenthesis, like this one; comments do not nest

   Extensions to ISO 14977:
     - Terminals understand the escapes \n, \r, \t, \\, \" and \'.
     - "a" .. "z"     any one character from "a" to "z", both included.
     - Rule names are written in snake_case, without spaces.

   What a grammar cannot say, and the compiler checks in addition:
     - An integer literal must fit in a signed 64-bit integer.
     - A name that is used must be a variable or a parameter of its procedure or a constant of the
       module, a variable can only be used below its definition, and no name may be declared twice,
       for example a variable may not have the name of a parameter. This is scope resolution, which
       the compiler does after parsing.
     - The types in a program must make sense for the target, for example `Str` has no addition,
       which the grammar cannot tell from `Int`, and the value of a variable must be of the type
       that the variable is given.
     - A line may be indented by any number of spaces that is a multiple of 4. The grammar only
       has blocks nested up to the fourth level, see `block_1`. Deeper nesting is accepted by the
       compiler, up to 32 blocks inside each other, and the grammar needs more rules for it.
     - The condition of an if statement must compare `Int` values, and a variable defined in a
       block can only be used in that block. Both are checked after parsing.
*)

module = { blank_line | definition } , end_of_input ;

(* A constant definition. It starts in the first column, so a line that starts with a space or a
   tab does not match here. `::` is two separate ':' characters for the compiler, so spaces may
   be between them. The value is a procedure, or a string on one line. *)
definition =
    name , ws , ":" , ws , ":" , ws , ( procedure | string_literal , ws , line_end ) ;

(* A procedure and its body. The optional name before the arrow is the return type. *)
procedure =
    "proc" , ws , "(" , ws , [ parameters , ws ] , ")" , ws , [ return_type , ws ] , "->" , ws ,
    line_end , procedure_body ;

(* One or more parameters, separated by commas. There is no comma after the last one. *)
parameters = parameter , { ws , "," , ws , parameter } ;

(* The name of the parameter, and its type. *)
parameter = name , ws , ":" , ws , type_name ;

type_name = name ;

return_type = name ;

(* At least one statement. Blank lines are allowed before, between and after statements, and are
   not statements. The body is indented exactly one level, 4 spaces. A tab, or any other number of
   spaces, does not match. *)
procedure_body = block_1 ;

(* A grammar has no way to say "one level deeper than the line above", so there is a set of rules
   for each level of indentation. A block is the lines of a body, or of a branch of an if
   statement, which is indented one level deeper than the `if`. A block has at least one
   statement, and blank lines are allowed before, between and after them, so a blank line before an
   `else` belongs to the block above it. The rules go down to the fourth level, which is the body
   and three if statements inside each other. The compiler accepts 32 levels of blocks, and
   deeper nesting would be more sets of rules like these. *)
block_1 = { blank_line } , statement_1 , { blank_line | statement_1 } ;
statement_1 = simple_statement_1 | if_statement_1 ;
simple_statement_1 =
    indentation_1 , ( return_statement | variable_definition | assignment ) , ws , line_end ;
if_statement_1 =
    indentation_1 , "if" , required_space , condition , branch_end , block_2 ,
    { indentation_1 , "else" , required_space , "if" , required_space , condition , branch_end ,
      block_2 } ,
    [ indentation_1 , "else" , branch_end , block_2 ] ;

block_2 = { blank_line } , statement_2 , { blank_line | statement_2 } ;
statement_2 = simple_statement_2 | if_statement_2 ;
simple_statement_2 =
    indentation_2 , ( return_statement | variable_definition | assignment ) , ws , line_end ;
if_statement_2 =
    indentation_2 , "if" , required_space , condition , branch_end , block_3 ,
    { indentation_2 , "else" , required_space , "if" , required_space , condition , branch_end ,
      block_3 } ,
    [ indentation_2 , "else" , branch_end , block_3 ] ;

block_3 = { blank_line } , statement_3 , { blank_line | statement_3 } ;
statement_3 = simple_statement_3 | if_statement_3 ;
simple_statement_3 =
    indentation_3 , ( return_statement | variable_definition | assignment ) , ws , line_end ;
if_statement_3 =
    indentation_3 , "if" , required_space , condition , branch_end , block_4 ,
    { indentation_3 , "else" , required_space , "if" , required_space , condition , branch_end ,
      block_4 } ,
    [ indentation_3 , "else" , branch_end , block_4 ] ;

block_4 = { blank_line } , statement_4 , { blank_line | statement_4 } ;
statement_4 = simple_statement_4 ;
simple_statement_4 =
    indentation_4 , ( return_statement | variable_definition | assignment ) , ws , line_end ;

(* The `if` with its first condition, any number of `else if`, and at most one `else` that comes
   last. The `->` ends the line, and what is indented below it is the block of the branch. *)
branch_end = ws , "->" , ws , line_end ;

(* A comparison of two expressions. It is not an expression itself: there is no value for true
   and false yet, so a comparison is only the condition of a branch. *)
condition = expression , ws , comparison_operator , ws , expression ;

comparison_operator = "==" | "!=" | "<=" | ">=" | "<" | ">" ;

indentation_1 = "    " ;
indentation_2 = "        " ;
indentation_3 = "            " ;
indentation_4 = "                " ;

(* A variable and its initial value. `:=` is a ':' and a '=' for the compiler, so spaces may be
   between them, as for `::`. Without a type the type of the variable is the type of the value.
   `x : Int = 5` gives the type. *)
variable_definition = name , ws , ":" , ws , [ type_name , ws ] , "=" , ws , expression ;

(* An assignment to a variable that is already defined: `x += 2` adds 2 to `x`, `x -= 2`
   subtracts 2 from it, `x *= 2` multiplies it by 2, and `x /= 2` divides it by 2. The operator
   is a single token, so no space may be written inside it. The name must be a variable, not a
   parameter or a constant, which the grammar cannot tell. *)
assignment = name , ws , ( "+=" | "-=" | "*=" | "/=" ) , ws , expression ;

(* `return` and its value must be separated, or `return0` would be one identifier. *)
return_statement = "return" , required_space , expression ;

(* Terms joined by `+` or `-`, which have the same precedence. The compiler reads `a - b + c` as
   `(a - b) + c`, which a grammar that only accepts or rejects text does not show. Spaces around
   the operator are optional. *)
expression = term , { ws , ( "+" | "-" ) , ws , term } ;

(* Operands joined by `*` or `/`, which have the same precedence and bind tighter than `+` and `-`:
   the compiler reads `a + b * c` as `a + (b * c)`, which the grammar does not show either. *)
term = operand , { ws , ( "*" | "/" ) , ws , operand } ;

(* An integer literal, a string literal, or the use of a name, such as a parameter or a constant. *)
operand = integer_literal | string_literal | name ;

(* Text between quotes, on one line. It is taken as it is: there are no escape sequences yet, so a
   backslash is not allowed, to keep it free for them. Any other character is, including a tab
   and characters that are not ASCII. The grammar works on characters, so it only sees text that
   is valid UTF-8; the compiler works on bytes and rejects a string that is not. *)
string_literal = '"' , { string_character } , '"' ;

string_character = any_character - ( '"' | "\\" | "\n" | "\r" ) ;

any_character = ? any character ? ;

(* Names. An identifier that is a reserved word is not a name. *)
name = identifier - reserved_word ;

reserved_word = "proc" | "return" | "if" | "else" ;

identifier = ( letter | "_" ) , { letter | digit | "_" } ;

(* A number is written in decimal, and a letter or underscore may not follow it directly. Both
   are guaranteed because only a space, an operator, a line end or the end of input is allowed after
   it. *)
integer_literal = digit , { digit } ;

letter = "a" .. "z" | "A" .. "Z" ;

digit = "0" .. "9" ;

(* Spaces inside a line. A carriage return counts as one, so lines may end with \r\n. *)
ws = { " " | "\t" | "\r" } ;

required_space = ( " " | "\t" | "\r" ) , ws ;

(* A line with nothing on it but spaces. It carries no indentation, so its width does not matter. *)
blank_line = ws , line_end ;

(* The last line of a file does not need a line feed. *)
line_end = "\n" | end_of_input ;

end_of_input = ? end of input ? ;
